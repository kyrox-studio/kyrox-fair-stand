FAIR_STAND_DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/fair_stand
JWT_SECRET_KEY=dev-insecure-change-me-use-env-in-production-32b
JWT_ALGORITHM=HS256
KYROX_CORE_BASE_URL=http://127.0.0.1:8000
# Core CORE_PRODUCT_LIFECYCLE_TOKEN ile aynı değer (en az 32 karakter, dev-insecure değil).
# Boşsa organizasyona ait yazmalar 503 ile durur (fail-closed).
KYROX_CORE_PRODUCT_LIFECYCLE_TOKEN=
APP_ENV=development
FAIR_STAND_DEV_BYPASS_CORE=false
# Live tab share signaling. Video is peer-to-peer. TURN stays empty until an
# office-network to mobile-data call fails STUN. That failure is not a V1 defect.
FAIR_STAND_LIVE_SHARE_STUN_URLS=stun:stun.l.google.com:19302
FAIR_STAND_LIVE_SHARE_TURN_URLS=
FAIR_STAND_LIVE_SHARE_TURN_USERNAME=
FAIR_STAND_LIVE_SHARE_TURN_CREDENTIAL=
